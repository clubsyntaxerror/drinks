# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Service account email with read access to the drinks spreadsheet
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key. Keep the literal \n sequences; the code un-escapes them.
GOOGLE_SHEETS_PRIVATE_KEY=

# The drinks/elixirs spreadsheet ID (the long id in its URL), NOT the website's events spreadsheet
DRINKS_SPREADSHEET_ID=
